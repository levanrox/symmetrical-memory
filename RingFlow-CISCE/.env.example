# ─────────────────────────────────────────────────────────────────────────────
# RingFlow — environment template.
#
#   cp .env.example .env.local
#
# Local development runs PostgreSQL (native, or the optional compose `db`) plus
# PostgREST from docker-compose.yml:
#   docker compose up -d postgrest
#   npm run gateway          # see note below
#
# For a hosted Supabase project instead, replace the three NEXT_PUBLIC_/SERVICE
# values below with your project URL and keys, and apply supabase/master.sql.
# ─────────────────────────────────────────────────────────────────────────────

# Drizzle ORM — direct PostgreSQL connection used by server actions and scripts.
DATABASE_URL="postgres://event_suite:event_suite@127.0.0.1:5432/ringflow"

# Supabase JS client — talks to PostgREST, so this must be the local gateway
# (port 54321), NOT PostgREST itself. The client requests /rest/v1/..., but
# PostgREST serves at the root, so hitting PostgREST directly returns 404. The
# gateway strips the prefix; start it with `npm run gateway`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Port PostgREST binds and the gateway forwards to (see docker-compose.yml).
# 54323 is used instead of the usual 54322 to avoid other local tooling.
# PGRST_SERVER_PORT=54323

# Local-only JWTs signed with the PGRST_JWT_SECRET in docker-compose.yml.
# Replace these with your project keys when using hosted Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9.eyJyb2xlIjogImV2ZW50X3N1aXRlIiwgImlzcyI6ICJzdXBhYmFzZSIsICJleHAiOiAyNTAwMDAwMDAwfQ.rMGdoti03QZwO3k_1V67Sr6RZRVcdwqQ56-brnTmI1E
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9.eyJyb2xlIjogImV2ZW50X3N1aXRlIiwgImlzcyI6ICJzdXBhYmFzZSIsICJleHAiOiAyNTAwMDAwMDAwfQ.rMGdoti03QZwO3k_1V67Sr6RZRVcdwqQ56-brnTmI1E

# Cloudflare Turnstile (test keys — always pass). Not enforced locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
