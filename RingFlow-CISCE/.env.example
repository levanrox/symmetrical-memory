# ─────────────────────────────────────────────────────────────────────────────
# RingFlow — Environment Configuration Template
#
# Two files matter:
#   .env        — compose + shared secrets. Generate with:
#                   node scripts/gen-supabase-secrets.mjs
#                 (docker compose AND Next.js both read this file)
#   .env.local  — machine-specific overrides for the Next.js app
#                 (DATABASE_URL host, LAN URLs). Copy the relevant bits below.
#
# RingFlow connects directly to PostgreSQL via Drizzle ORM and delivers
# real-time updates across all screens via self-hosted Supabase Realtime
# (WebSocket broadcast) — no internet access required.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Database Connection (Required) ─────────────────────────────────────────
# Direct PostgreSQL connection string used by Drizzle ORM, server actions, and scripts.
#
# • If running Docker Compose db on Windows/Linux localhost:
#   DATABASE_URL="postgres://event_suite:<POSTGRES_PASSWORD>@127.0.0.1:5432/ringflow"
#
# • If running PostgreSQL inside a WSL2 container accessed from Windows host:
#   DATABASE_URL="postgres://event_suite:<POSTGRES_PASSWORD>@<WSL_OR_CONTAINER_IP>:5432/ringflow"
#
# • For cloud/production (Supabase Postgres, Neon, RDS):
#   DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
#
# NOTE: POSTGRES_PASSWORD lives in .env (generated). Keep it URL-safe
# (alphanumeric) so it can be embedded in DATABASE_URL.
DATABASE_URL="postgres://event_suite:event_suite@127.0.0.1:5432/ringflow"

# ── 2. Self-hosted Supabase Realtime ──────────────────────────────────────────
# The realtime container (docker compose service `realtime`) needs:
#   SUPABASE_JWT_SECRET, SECRET_KEY_BASE  → in .env (generated)
#
# The Next.js server publishes events to Realtime. When the app runs on the
# host, Realtime is at localhost:4000; when the app runs as the compose `app`
# service, compose sets REALTIME_URL=http://realtime:4000 for you.
REALTIME_URL="http://localhost:4000"

# Browsers open their WebSocket against this URL, so for LAN event deployments
# it must be reachable from the clients (the server's LAN IP, not localhost).
# It is baked into the client bundle at build time. You may leave it empty —
# browsers then derive it from the page's own hostname as http(s)://<host>:4000.
# NEXT_PUBLIC_REALTIME_URL="http://192.168.1.50:4000"

# Realtime auth keys (in .env, generated — shown here for reference):
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=...   # public; browsers subscribe with this
#   SUPABASE_SERVICE_ROLE_KEY=...       # server only; the app publishes with this
# Both are JWTs signed with SUPABASE_JWT_SECRET and must stay in sync with the
# realtime container's API_JWT_SECRET.

# ── 3. App URL / Supabase Integration (optional hosted features) ──────────────
# Only needed if you use hosted Supabase features (e.g. Storage buckets).
#
# • For local development (desktop & mobile test on localhost):
#   NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
#
# • For hosted Supabase (optional, if using Supabase Storage or Auth):
#   NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000

# ── 4. Bot Protection / Cloudflare Turnstile ──────────────────────────────────
# Default test keys provided below always pass validation in development/staging.
# In production, create a free widget at https://dash.cloudflare.com/ -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ── 5. App Runtime (compose services) ─────────────────────────────────────────
# These are consumed by the compose `app` service (and some by host scripts).
# Secrets marked "generated" are written into .env by:
#   node scripts/gen-supabase-secrets.mjs

# Signs admin/moderator session cookies (64+ hex chars).
# Generate: openssl rand -hex 32   (or let gen-supabase-secrets.mjs do it)
# When unset, the app falls back to SECRET_KEY_BASE — set this in production.
SESSION_SECRET=<generated - 64 hex chars>

# Direct PostgreSQL connection, bypassing the PgBouncer pooler.
# Used by the realtime LISTEN bridge (LISTEN/NOTIFY cannot go through
# transaction-mode pooling) and by migration scripts. Compose sets this for
# the app automatically; define it here for host-run scripts if needed.
# DATABASE_DIRECT_URL=<redacted>

# First admin login password. Required on first login when no admin account
# exists yet (the bootstrap is disabled afterwards). Set it, log in once,
# then remove it from .env.
ADMIN_BOOTSTRAP_PASSWORD=<choose-a-strong-password>

# Bot protection for public-facing forms (moderator/organiser requests).
# Default is off: the event LAN is offline and Turnstile needs the internet.
# Set to "true" only when the server has internet access AND you have real
# Turnstile keys configured (see section 4).
TURNSTILE_ENABLED=false

# Uploaded-file storage. "local" (default) writes PDFs under FILE_STORAGE_DIR;
# "supabase" uses a Supabase Storage bucket instead (needs hosted Supabase).
FILE_STORAGE_BACKEND=local
FILE_STORAGE_DIR=./data/uploads

# Extra origins allowed for next dev (comma-separated). Production builds
# ignore this. Useful when developing against the server's LAN IP.
# ALLOWED_DEV_ORIGINS=http://192.168.1.50:3000

# Judge access (PHASE P7a). Public base URL judges use when the server is
# reached through a tunnel (scripts/start-judge-tunnel.sh prints it).
# Wins over the DB app-settings value. Leave unset for venue-WiFi mode,
# where judge join links are relative (/j/<code>) and work same-origin.
# JUDGE_BASE_URL=https://<your-tunnel>.trycloudflare.com

# Cookie `Secure` flag override. By default the app sets Secure when the
# request arrived over HTTPS (or behind a TLS-terminating proxy that sends
# X-Forwarded-Proto). Set COOKIE_SECURE=false to force insecure cookies
# (plain-HTTP LAN without a proxy), or true to force Secure always.
# COOKIE_SECURE=
