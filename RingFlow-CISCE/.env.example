# ─────────────────────────────────────────────────────────────────────────────
# RingFlow — Environment Configuration Template
#
# Quick setup for local development:
#   cp .env.example .env.local
#
# RingFlow connects directly to PostgreSQL via Drizzle ORM and delivers real-time
# updates across all screens using Server-Sent Events (SSE) via /api/live.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Database Connection (Required) ─────────────────────────────────────────
# Direct PostgreSQL connection string used by Drizzle ORM, server actions, and scripts.
#
# • If running Docker Compose db on Windows/Linux localhost:
#   DATABASE_URL="postgres://event_suite:event_suite@127.0.0.1:5432/ringflow"
#
# • If running PostgreSQL inside a WSL2 container accessed from Windows host:
#   DATABASE_URL="postgres://event_suite:event_suite@<WSL_OR_CONTAINER_IP>:5432/ringflow"
#
# • For cloud/production (Supabase Postgres, Neon, RDS):
#   DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL="postgres://event_suite:event_suite@127.0.0.1:5432/ringflow"

# ── 2. App URL / Supabase Integration ─────────────────────────────────────────
# RingFlow's frontend and live SSE engine run directly through the Next.js server.
#
# • For local development (desktop & mobile test on localhost):
#   NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
#
# • For hosted Supabase (optional, if using Supabase Storage or Auth):
#   NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000

# Local development mock JWT tokens (used when running purely local):
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9.eyJyb2xlIjogImV2ZW50X3N1aXRlIiwgImlzcyI6ICJzdXBhYmFzZSIsICJleHAiOiAyNTAwMDAwMDAwfQ.rMGdoti03QZwO3k_1V67Sr6RZRVcdwqQ56-brnTmI1E
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9.eyJyb2xlIjogImV2ZW50X3N1aXRlIiwgImlzcyI6ICJzdXBhYmFzZSIsICJleHAiOiAyNTAwMDAwMDAwfQ.rMGdoti03QZwO3k_1V67Sr6RZRVcdwqQ56-brnTmI1E

# ── 3. Bot Protection / Cloudflare Turnstile ──────────────────────────────────
# Default test keys provided below always pass validation in development/staging.
# In production, create a free widget at https://dash.cloudflare.com/ -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
