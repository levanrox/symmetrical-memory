# Copy to .env (or export these) before running the server.
#
# Every value below has a working default for local development, so the only
# one you must set for anything real is JWT_SECRET.

# Postgres. Matches docker-compose.yml out of the box.
DATABASE_URL=postgres://event_suite:event_suite@127.0.0.1:5432/event_suite

# Used only by the automated tests; they each need their own database because
# the test runner executes packages in parallel.
#   createdb -O event_suite event_suite_test
#   createdb -O event_suite event_suite_e2e
TEST_DATABASE_URL=postgres://event_suite:event_suite@127.0.0.1:5432/event_suite_test
E2E_DATABASE_URL=postgres://event_suite:event_suite@127.0.0.1:5432/event_suite_e2e

# Required in production. The server refuses to start without it when
# NODE_ENV=production.
JWT_SECRET=change-me-before-any-real-event

# Event server bind address. 0.0.0.0 so rings on the LAN can reach it.
PORT=4000
HOST=0.0.0.0

# Where the web app looks for the API. Leave unset to derive it from the
# page's own hostname, which is what you want on a venue network.
# NEXT_PUBLIC_API_URL=http://192.168.1.10:4000
# NEXT_PUBLIC_API_PORT=4000
